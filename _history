 / distance2 * speed\n        let vy2 = dy2 / distance2 * speed\n\n        sprites.createProjectileFromSprite(projectileImage, shooter, vx2, vy2)\n    }\n\n    /**\n     * Point one sprite towards another sprite.\n     * Useful if you want enemies to visually face the player.\n     */\n    //% block=\"point sprite %sprite towards %target\"\n    //% group=\"Aiming\"\n    export function pointTowardsSprite(sprite: Sprite, target: Sprite): void {\n        if (!sprite || !target) return\n\n        let dx3 = target.x - sprite.x\n        let dy3 = target.y - sprite.y\n\n        sprite.setImage(sprite.image)\n        sprite.vx = sprite.vx\n        sprite.vy = sprite.vy\n\n        // Angle is stored if you want to extend this later,\n        // but not needed for the shooting blocks.\n        let angle = Math.atan2(dy3, dx3)\n    }\n}\n","README.md":" ","assets.json":"","custom.ts":"\n/**\n* Use this file to define custom functions and blocks.\n* Read more at https://arcade.makecode.com/blocks/custom\n*/\n\nenum MyEnum {\n    //% block=\"one\"\n    One,\n    //% block=\"two\"\n    Two\n}\n\n/**\n * Custom blocks\n */\n//% weight=100 color=#0fbc11 icon=\"\"\nnamespace custom {\n    /**\n     * TODO: Creates a projectile that fires from an enemy at a player\n     * @param enemy represents the enemy sprite\n     * @param player represents the player sprite\n     * @param speed represents the speed of the created projectile\n     */\n    //% block\n    //% group =\"Projectiles\"\n    export function enemyFireAtPlayer(enemy: Sprite, player: Sprite, speed:number): void {\n        let dx = player.x - enemy.x\n        let dy = player.y - enemy.y\n        let distance = Math.sqrt(dx * dx + dy * dy)\n\n        if (distance <= 0) return\n\n        let vx = dx / distance * speed\n        let vy = dy / distance * speed\n\n        sprites.createProjectileFromSprite(img`\n            2 2\n            2 2\n        `, enemy, vx, vy)\n    }\n\n    /**\n     * TODO: describe your function he