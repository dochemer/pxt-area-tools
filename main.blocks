<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable type="KIND_SpriteKind" id="X{GQH#fVm2``7jo2Rbn9">EnemyProjectile</variable></variables><block type="pxt-on-start" id="r8tykto{!R3W3brpuvBg" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="x(jAfZuvwyn-|iSAKhzB"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace arenaTools {" line1="" line2="    /**" line3="     * Make one sprite shoot a small default projectile at another sprite." line4="     */" line5="    //% block=&quot;sprite %shooter shoot at %target with speed %speed&quot;" line6="    //% speed.defl=50" line7="    //% group=&quot;Projectiles&quot;" line8="    export function shootAtSprite(shooter: Sprite, target: Sprite, speed: number): void {" line9="        if (!shooter || !target) return" line10="" line11="        let dx = target.x - shooter.x" line12="        let dy = target.y - shooter.y" line13="        let distance = Math.sqrt(dx * dx + dy * dy)" line14="" line15="        if (distance &lt;= 0) return" line16="" line17="        let vx = dx / distance * speed" line18="        let vy = dy / distance * speed" line19="" line20="        let projectile = sprites.createProjectileFromSprite(img`" line21="            2 2" line22="            2 2" line23="        `, shooter, vx, vy)" line24="" line25="        projectile.setKind(SpriteKind.EnemyProjectile)" line26="    }" line27="" line28="    //% block=&quot;on player overlaps enemy projectile&quot;" line29="    //% draggableParameters=&quot;reporter&quot;" line30="    export function onPlayerOverlapsEnemyProjectile(handler: (player: Sprite, projectile: Sprite) =&gt; void) {" line31="        sprites.onOverlap(SpriteKind.Player, SpriteKind.EnemyProjectile, handler)" line32="    }" line33="    " line34="    /**" line35="     * Make one sprite shoot a custom projectile image at another sprite." line36="     */" line37="    //% block=&quot;sprite %shooter shoot image %projectileImage at %target with speed %speed&quot;" line38="    //% speed.defl=50" line39="    //% projectileImage.shadow=screen_image_picker" line40="    //% group=&quot;Projectiles&quot;" line41="    export function shootImageAtSprite(shooter: Sprite, projectileImage: Image, target: Sprite, speed: number): void {" line42="        if (!shooter || !target) return" line43="        if (!projectileImage) return" line44="" line45="        let dx2 = target.x - shooter.x" line46="        let dy2 = target.y - shooter.y" line47="        let distance2 = Math.sqrt(dx2 * dx2 + dy2 * dy2)" line48="" line49="        if (distance2 &lt;= 0) return" line50="" line51="        let vx2 = dx2 / distance2 * speed" line52="        let vy2 = dy2 / distance2 * speed" line53="" line54="        let projectile2 = sprites.createProjectileFromSprite(projectileImage, shooter, vx2, vy2)" line55="        projectile2.setKind(SpriteKind.EnemyProjectile)" line56="    }" line57="" line58="    /**" line59="     * Point one sprite towards another sprite." line60="     * Useful if you want enemies to visually face the player." line61="     */" line62="    //% block=&quot;point sprite %sprite towards %target&quot;" line63="    //% group=&quot;Aiming&quot;" line64="    export function pointTowardsSprite(sprite: Sprite, target: Sprite): void {" line65="        if (!sprite || !target) return" line66="" line67="        let dx3 = target.x - sprite.x" line68="        let dy3 = target.y - sprite.y" line69="" line70="        sprite.setImage(sprite.image)" line71="        sprite.vx = sprite.vx" line72="        sprite.vy = sprite.vy" line73="" line74="        // Angle is stored if you want to extend this later," line75="        // but not needed for the shooting blocks." line76="        let angle = Math.atan2(dy3, dx3)" line77="    }" line78="" line79="    /**" line80="     * Update the enemy sprite based on the direction it is currently moving in." line81="     */" line82="    //% block=&quot;update enemy facing %enemy left %leftImg right %rightImg up %upImage down %downImage&quot;" line83="    //% leftImg.shadow=screen_image_picker" line84="    //% rightImg.shadow=screen_image_picker" line85="    //% upImage.shadow=screen_image_picker" line86="    //% downImage.shadow=screen_image_picker" line87="    //% group=&quot;Facing&quot;" line88="    export function updateEnemyFacing(enemy: Sprite, leftImg: Image, rightImg: Image, upImage: Image, downImage: Image) {" line89="        if (enemy.vx &lt;= 0 &amp;&amp; enemy.vy &lt;= 0) {" line90="            if (Math.abs(enemy.vx) &gt;= Math.abs(enemy.vy)) {" line91="                enemy.setImage(leftImg)" line92="            } else {" line93="                enemy.setImage(upImage)" line94="            }" line95="        } else if (enemy.vx &gt;= 0 &amp;&amp; enemy.vy &lt;= 0) {" line96="            if (Math.abs(enemy.vx) &gt;= Math.abs(enemy.vy)) {" line97="                enemy.setImage(rightImg)" line98="            } else {" line99="                enemy.setImage(upImage)" line100="            }" line101="        } else if (enemy.vx &gt;= 0 &amp;&amp; enemy.vy &gt;= 0) {" line102="            if (Math.abs(enemy.vx) &gt;= Math.abs(enemy.vy)) {" line103="                enemy.setImage(rightImg)" line104="            } else {" line105="                enemy.setImage(downImage)" line106="            }" line107="        } else {" line108="            if (Math.abs(enemy.vx) &gt;= Math.abs(enemy.vy)) {" line109="                enemy.setImage(leftImg)" line110="            } else {" line111="                enemy.setImage(downImage)" line112="            }" line113="        }" line114="    }" line115="}" numlines="116"></mutation></block></statement></block></xml>