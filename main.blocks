<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="r9,a!RP~)pjN?Hq%#%$]" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="0X3B5v|,P.pbTsRO%Mla"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace arenaTools {" line1="" line2="    /**" line3="     * Make one sprite shoot a small default projectile at another sprite." line4="     */" line5="    //% block=&quot;sprite %shooter shoot at %target with speed %speed&quot;" line6="    //% speed.defl=50" line7="    //% group=&quot;Projectiles&quot;" line8="    export function shootAtSprite(shooter: Sprite, target: Sprite, speed: number): void {" line9="        if (!shooter || !target) return" line10="" line11="        let dx = target.x - shooter.x" line12="        let dy = target.y - shooter.y" line13="        let distance = Math.sqrt(dx * dx + dy * dy)" line14="" line15="        if (distance &lt;= 0) return" line16="" line17="        let vx = dx / distance * speed" line18="        let vy = dy / distance * speed" line19="" line20="        sprites.createProjectileFromSprite(img`" line21="            2 2" line22="            2 2" line23="        `, shooter, vx, vy)" line24="    }" line25="" line26="    /**" line27="     * Make one sprite shoot a custom projectile image at another sprite." line28="     */" line29="    //% block=&quot;sprite %shooter shoot image %projectileImage at %target with speed %speed&quot;" line30="    //% speed.defl=50" line31="    //% projectileImage.shadow=screen_image_picker" line32="    //% group=&quot;Projectiles&quot;" line33="    export function shootImageAtSprite(shooter: Sprite, projectileImage: Image, target: Sprite, speed: number): void {" line34="        if (!shooter || !target) return" line35="        if (!projectileImage) return" line36="" line37="        let dx2 = target.x - shooter.x" line38="        let dy2 = target.y - shooter.y" line39="        let distance2 = Math.sqrt(dx2 * dx2 + dy2 * dy2)" line40="" line41="        if (distance2 &lt;= 0) return" line42="" line43="        let vx2 = dx2 / distance2 * speed" line44="        let vy2 = dy2 / distance2 * speed" line45="" line46="        sprites.createProjectileFromSprite(projectileImage, shooter, vx2, vy2)" line47="    }" line48="" line49="    /**" line50="     * Point one sprite towards another sprite." line51="     * Useful if you want enemies to visually face the player." line52="     */" line53="    //% block=&quot;point sprite %sprite towards %target&quot;" line54="    //% group=&quot;Aiming&quot;" line55="    export function pointTowardsSprite(sprite: Sprite, target: Sprite): void {" line56="        if (!sprite || !target) return" line57="" line58="        let dx3 = target.x - sprite.x" line59="        let dy3 = target.y - sprite.y" line60="" line61="        sprite.setImage(sprite.image)" line62="        sprite.vx = sprite.vx" line63="        sprite.vy = sprite.vy" line64="" line65="        // Angle is stored if you want to extend this later," line66="        // but not needed for the shooting blocks." line67="        let angle = Math.atan2(dy3, dx3)" line68="    }" line69="}" numlines="70"></mutation></block></statement></block></xml>